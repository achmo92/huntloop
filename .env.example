# HuntLoop environment template.
# Copy to .env and fill in. `.env` is gitignored; `.env.example` is committed.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# REQUIRED. The key that encrypts your stored API credentials.
# Generate it ONCE and keep it like a password:
#   openssl rand -base64 32
# HuntLoop refuses to start without it. That refusal is deliberate: an
# auto-generated key written into the data volume would be captured by every
# backup of that volume, alongside the data it is meant to protect.
# Keep this file OUTSIDE HUNTLOOP_DATA_DIR. See docs/operations/backup-restore.md
# ---------------------------------------------------------------------------
HUNTLOOP_SECRET_KEY=

# ---------------------------------------------------------------------------
# Where the databases live. Inside Docker this is /data, backed by the named
# `data` volume in docker-compose.yml.
# ---------------------------------------------------------------------------
HUNTLOOP_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Main application database. This is the ONE value to change to run against
# Postgres instead of SQLite. See docs/operations/database-backends.md
#   SQLite   (default): sqlite:////data/huntloop.db
#   Postgres          : postgresql+psycopg://huntloop:CHANGEME@db:5432/huntloop
# The postgresql+psycopg:// prefix is required (psycopg3). A bare
# postgresql:// or a postgresql+psycopg2:// URL is rejected at startup.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:////data/huntloop.db

# ---------------------------------------------------------------------------
# Credentials database. Always a local SQLite file, deliberately: it must NOT
# follow DATABASE_URL. A managed Postgres provider's snapshots would otherwise
# carry your encrypted API key, reintroducing the problem the separate store
# exists to prevent. HuntLoop rejects any non-sqlite value here.
# ---------------------------------------------------------------------------
CREDENTIALS_DATABASE_URL=sqlite:////data/credentials.db

# --- Phase 2: the ONE OpenAI-compatible endpoint (OPS-06) ---
HUNTLOOP_OPENAI_BASE_URL=https://api.openai.com/v1
HUNTLOOP_OPENAI_API_KEY=        # builder fallback; the credentials store wins if it has 'openai_api_key'
HUNTLOOP_TRIAGE_MODEL=gpt-4o-mini
HUNTLOOP_SCORING_MODEL=gpt-4o
HUNTLOOP_EXTRACTION_MODEL=      # blank => same as HUNTLOOP_TRIAGE_MODEL

# --- Phase 4 hardening: browser-origin / host boundary (T-04-02) ---
# Hostname allowlist for the web surface. Bare IP hosts (e.g. a LAN address)
# are always accepted, so http://192.168.1.50:8000 keeps working. Add DNS
# names or reverse-proxy hostnames here. Comma-separated.
HUNTLOOP_ALLOWED_HOSTS=localhost,127.0.0.1
# Exact origins additionally accepted for state-changing requests (default
# empty = strict same-origin). Only needed if a proxy rewrites Host.
HUNTLOOP_ALLOWED_ORIGINS=

# --- Phase 2: pipeline tuning ---
HUNTLOOP_MAX_EMPLOYER_CONCURRENCY=5
HUNTLOOP_STALE_AFTER_EMPTY_RUNS=3

# --- Phase 3: unattended scheduling (RUN-01, RUN-04) ---
# One run per day at this 24-hour wall-clock time, interpreted in HUNTLOOP_TIMEZONE.
HUNTLOOP_RUN_AT=08:00
# IANA timezone name. A daily time-of-day setting is meaningless without knowing
# whose 8am it is. HuntLoop stores and reasons in UTC internally and converts only
# to interpret HUNTLOOP_RUN_AT. A typo here is a startup error, not a silent default.
HUNTLOOP_TIMEZONE=UTC

# --- Phase 3: per-run spend cap (RUN-08) ---
# Hard ceiling in US dollars for model spend within ONE run. Checked before every
# individual triage and scoring call, so the run stops BEFORE spending past it.
# Leave blank for no cap. Listings not yet scored when the cap hits are held back
# (not written) and are picked up naturally by the next run.
HUNTLOOP_RUN_SPEND_CAP_USD=
